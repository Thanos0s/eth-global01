{
  "name": "ethlisbon-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "prebuild": "npm run compile:contracts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/contracts.test.ts src/__tests__/rateLimit.test.ts src/__tests__/outbox.test.ts src/__tests__/sessionPolicy.test.ts src/__tests__/auth.test.ts",
    "test:integration": "vitest run src/__tests__/holderAuth.test.ts src/__tests__/agentAuth.test.ts src/__tests__/sessionValidator.test.ts",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:postgres": "vitest run src/__tests__/postgres.test.ts",
    "test:all": "npm run test && npm run test:contracts && node scripts/test-subgraph.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hiero-ledger/proto": "^2.31.0",
    "@hiero-ledger/sdk": "2.79.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-common": "^1.8.23",
    "@reown/appkit-controllers": "^1.8.23",
    "@reown/appkit-utils": "^1.8.23",
    "@reown/walletkit": "^1.5.6",
    "@types/pg": "^8.23.1",
    "@walletconnect/jsonrpc-http-connection": "^1.0.8",
    "@walletconnect/jsonrpc-provider": "^1.0.14",
    "@walletconnect/jsonrpc-utils": "^1.0.8",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.24.0",
    "@walletconnect/universal-provider": "^2.24.0",
    "@walletconnect/utils": "^2.24.0",
    "@worldcoin/idkit": "4.2.1",
    "@worldcoin/idkit-core": "4.2.2",
    "better-sqlite3": "^13.0.1",
    "ethers": "^6.17.0",
    "next": "16.2.11",
    "pg": "^8.23.0",
    "protobufjs": "^8.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "^0.7.0",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "hardhat": "^3.16.0",
    "pg-mem": "^3.0.14",
    "solc": "^0.8.30",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
