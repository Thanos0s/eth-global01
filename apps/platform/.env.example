# Hedera operator / treasury (server-side secrets)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=

# Ethereum Sepolia operator / treasury (server-side only)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_OPERATOR_PRIVATE_KEY=0x...

# Public WalletConnect/Reown project identifier, served to the browser at runtime
WALLETCONNECT_PROJECT_ID=

# Optional canonical public URL used in WalletConnect DApp metadata
# TOKENIZATION_APP_URL=https://your-service.up.railway.app/tokenization

# Production PostgreSQL Database Backend (Required in production - fail-closed)
DATABASE_URL=postgresql://postgres:password@localhost:5432/prism8?sslmode=disable
# Alternative PostgreSQL connection string alias:
# POSTGRES_URL=postgresql://postgres:password@localhost:5432/prism8

# Local development database (Used ONLY when NODE_ENV !== "production")
DATABASE_PATH=./data/tokenization.db

# World ID credential verification
# Selfie Check uses the production World App; Identity Check uses staging
# with the World Simulator. The RP signing key must remain server-side.
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxx
# Runtime alias used by the standalone Railway server (same value as above)
WORLD_APP_ID=app_xxxxx
WORLD_RP_ID=rp_xxxxx
WORLD_RP_SIGNING_KEY=0x...
WORLD_ACTION=selfie-check-demo
WORLD_IDENTITY_ACTION=identity-check-demo
NEXT_PUBLIC_WORLD_SIGNAL=rwa-marketplace-holder

# Security & Role-Based Authorization
# Comma-separated EVM addresses authorized to perform operator/admin mutations
OPERATOR_ADDRESSES=0x89205A3A3b2A69De6Dbf7f01ED13B2108B2c43e7,0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Shared secret for internal agent / background worker API calls
TOKENIZATION_AGENT_SECRET=replace_with_strong_random_secret_32_bytes

# Demo Mode Gate: false in all production environments.
# Set to true only in isolated demo/staging environments.
DEMO_MODE=false

# Deployed Session Key Module Addresses (ERC-7579)
SESSION_VALIDATOR_ADDRESS=0x7579C0de00000000000000000000000000007579
HERMES_AGENT_ADDRESS=0x89205A3A3b2A69De6Dbf7f01ED13B2108B2c43e7
SESSION_CHAIN_ID=84532
